# URL base de la API del backend (debe incluir el prefijo /api).
#
# - Simulador iOS: comparte la red del Mac -> "http://localhost:4000/api" funciona.
# - Emulador Android: "localhost" apunta al propio emulador, no al host ->
#   usa el alias especial "http://10.0.2.2:4000/api" (ya es el fallback por defecto).
# - Dispositivo físico con Expo Go en la misma red WiFi que tu computadora:
#   ni localhost ni 10.0.2.2 funcionan -> usa la IP LAN de tu computadora
#   (Windows: `ipconfig`, busca "Dirección IPv4") y ponla aquí, ej:
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/api
