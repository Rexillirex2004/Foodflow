# Base de datos PostgreSQL (ej. provisionada en Railway). Copia la connection
# string desde la pestaña "Variables" del servicio Postgres en Railway.
DATABASE_URL="postgresql://user:password@host:port/railway"

# Cambia este valor por uno propio y secreto antes de desplegar.
JWT_SECRET="change_this_super_secret_key"
JWT_EXPIRES_IN="7d"

PORT=4000

# Días de prueba gratuita al registrar un restaurante nuevo.
TRIAL_DAYS=14

# Precio y duración del plan único de suscripción (pago simulado).
SUBSCRIPTION_PRICE_CENTS=2999
SUBSCRIPTION_PERIOD_DAYS=30
